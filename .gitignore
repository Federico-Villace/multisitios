# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Los ZIP son OUTPUT DE BUILD, no fuente.
# La fuente es la carpeta nsf-*/ ; el ZIP se regenera con:
#   zip -q -r -X nsf-<plugin>.zip nsf-<plugin> -x '*.DS_Store' -x '__MACOSX/*'
# Versionar binarios no da diff y sólo infla el repositorio.
*.zip

# Backups y temporales de edición
*.bak
*~
*.orig

# Dependencias (por si en algún momento entra tooling)
node_modules/
vendor/
